        </insert>
        <insert tableName="job_title">
            <column name="id" value="658716e7-6284-491d-8838-2d47f0ba5cbf"/>
            <column name="title" value="Comptable"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
        <insert tableName="job_title">
            <column name="id" value="fee9cb19-116b-4cb2-a373-b5c399145173"/>
            <column name="title" value="Chef de Chantier"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
