<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-site" author="saint-pierre.kassi">
        <createTable tableName="site">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(500)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="site">
            <column name="id" value="1e2d3c4b-5a69-4788-9f10-1a2b3c4d5e01"/>
            <column name="name" value="Agence Dakar"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="site">
            <column name="id" value="1e2d3c4b-5a69-4788-9f10-1a2b3c4d5e02"/>
            <column name="name" value="ADT Chantier"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
